{
  "name": "vue3-vscode-snippets",
  "version": "0.8.0",
  "private": true,
  "description": "Vue 3 snippets for VS Code",
  "author": {
    "name": "Vasily Kuzin",
    "email": "exer7um@gmail.com",
    "url": "https://github.com/ExEr7um"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ExEr7um/vue3-vscode-snippets.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:fix": "vp check --fix",
    "eslint": "eslint --max-warnings=0",
    "eslint:fix": "eslint --max-warnings=0 --fix",
    "generate": "bun run scripts/generate-vscode-package.ts",
    "postinstall": "bun run generate",
    "prepare": "vp config",
    "publish": "bun run release && bun run --filter vue-3-vscode-snippets publish:vsce",
    "publish:ovsx": "bun run release && bun run --filter vue-3-vscode-snippets publish:ovsx",
    "release": "bun run generate && bun run scripts/sync-vscode-version.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@exer7um/eslint-config": "2.4.0",
    "@exer7um/vp-config": "0.1.0",
    "@types/node": "26.1.1",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.9.2",
    "ovsx": "1.0.2",
    "tsdown": "0.22.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
