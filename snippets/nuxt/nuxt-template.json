{
  "NuxtLink": {
    "body": ["<NuxtLink to=\"/${1:path}\">${2:linkTitle}</NuxtLink>"],
    "description": "Nuxt router link",
    "prefix": "nlink"
  },
  "NuxtLink with param": {
    "body": [
      "<NuxtLink :to=\"`/${1:path}/${${2:param}}`\">${3:linkTitle}</NuxtLink>"
    ],
    "description": "Nuxt router link with param",
    "prefix": "nlink-param"
  }
}
