  },
  "Vue Transition Group": {
    "body": [
      ".${1:transitionName}-move,",
      ".${1:transitionName}-enter-active,",
      ".${1:transitionName}-leave-active {",
      "\ttransition: opacity 0.5s ease;",
      "}",
      "",
      ".${1:transitionName}-enter-from,",
      ".${1:transitionName}-leave-to {",
      "\topacity: 0;",
      "}",
      "",
      ".${1:transitionName}-leave-active {",
      "\tposition: absolute;",
      "}"
