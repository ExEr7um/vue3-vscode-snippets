{
  "name": "vue-3-vscode-snippets",
  "displayName": "Vue 3 VS Code Snippets",
  "version": "0.8.0",
  "description": "Vue 3 snippets for VS Code",
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "Vue",
    "Vue 3",
    "Nuxt",
    "Nuxt 3",
    "Pinia",
    "Vue Snippets",
    "Vue 3 snippets",
    "Nuxt snippets",
    "Nuxt 3 snippets",
    "Pinia snippets",
    "Composition API"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ExEr7um/vue3-vscode-snippets.git"
  },
  "author": {
    "name": "Vasily Kuzin",
    "email": "exer7um@gmail.com",
    "url": "https://github.com/ExEr7um"
  },
  "contributors": [
    {
      "name": "Sarah Drasner",
      "email": "sarah.drasner@gmail.com",
      "url": "https://github.com/sdras"
    },
    {
      "name": "Daniel Kelly",
      "email": "me@danielkelly.io",
      "url": "https://github.com/danielkellyio"
    },
    {
      "name": "Fabian Kurz",
      "email": "info@fabian-kurz.de",
      "url": "https://github.com/pixel-fabian"
    }
  ],
  "publisher": "exer7um",
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "publish:ovsx": "ovsx publish --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "vscode:prepublish": "tsdown"
  },
  "contributes": {
    "configuration": {
      "title": "Vue 3 VS Code Snippets",
      "properties": {
        "vueSnippets.pstore.api": {
          "default": "composition",
          "enum": [
            "composition",
            "options"
          ],
          "markdownDescription": "API style of the `pstore` snippet: a setup function (`composition`) or a `state`/`getters`/`actions` object (`options`).",
          "type": "string"
        },
        "vueSnippets.pstore.hmr": {
          "default": true,
          "markdownDescription": "Add the `acceptHMRUpdate` block to the `pstore` snippet.",
          "type": "boolean"
        },
        "vueSnippets.vbase.scriptLang": {
          "default": "ts",
          "enum": [
            "js",
            "ts"
          ],
          "markdownDescription": "Language of the `<script>` block in the `vbase` snippet. `js` omits the `lang` attribute.",
          "type": "string"
        },
        "vueSnippets.vbase.scriptSetup": {
          "default": true,
          "markdownDescription": "Use `<script setup>` in the `vbase` snippet.",
          "type": "boolean"
        },
        "vueSnippets.vbase.scriptVapor": {
          "default": false,
          "markdownDescription": "Use `<script vapor>` in the `vbase` snippet. Vapor mode implies `setup`, so this shorthand is used regardless of `#vueSnippets.vbase.scriptSetup#`.",
          "type": "boolean"
        },
        "vueSnippets.vbase.styleLang": {
          "default": "scss",
          "enum": [
            "css",
            "less",
            "none",
            "postcss",
            "sass",
            "scss",
            "stylus"
          ],
          "markdownDescription": "Language of the `<style>` block in the `vbase` snippet. `none` omits the `<style>` block entirely.",
          "type": "string"
        },
        "vueSnippets.vbase.styleScoped": {
          "default": true,
          "markdownDescription": "Add the `scoped` attribute to the `<style>` block in the `vbase` snippet.",
          "type": "boolean"
        },
        "vueSnippets.vbase.templateRootTag": {
          "default": "div",
          "markdownDescription": "Root tag wrapping the cursor inside the `<template>` block in the `vbase` snippet. Empty string omits the wrapper.",
          "type": "string"
        },
        "vueSnippets.vbase.blockOrder": {
          "default": [
            "script",
            "template",
            "style"
          ],
          "items": {
            "enum": [
              "script",
              "template",
              "style"
            ],
            "type": "string"
          },
          "markdownDescription": "Order of the blocks in the `vbase` snippet. Blocks not listed here are omitted.",
          "type": "array",
          "uniqueItems": true
        }
      }
    },
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/generated/pstore.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/generated/pstore.json"
      },
      {
        "language": "vue",
        "path": "./snippets/generated/vbase.json"
      },
      {
        "language": "vue",
        "path": "./snippets/histoire/histoire.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/histoire/histoire-script.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/histoire/histoire-script.json"
      },
      {
        "language": "html",
        "path": "./snippets/histoire/histoire-template.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/nuxt/nuxt-script.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/nuxt/nuxt-script.json"
      },
      {
        "language": "html",
        "path": "./snippets/nuxt/nuxt-template.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/vitest/nuxt.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/vitest/nuxt.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/vitest/vitest.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/vitest/vitest.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/vitest/vue.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/vitest/vue.json"
      },
      {
        "language": "css",
        "path": "./snippets/vue/vue-css.json"
      },
      {
        "language": "less",
        "path": "./snippets/vue/vue-css.json"
      },
      {
        "language": "scss",
        "path": "./snippets/vue/vue-css.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/vue/vue-router.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/vue/vue-router.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/vue/vue-script.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/vue/vue-script.json"
      },
      {
        "language": "html",
        "path": "./snippets/vue/vue-template.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:vue"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "icon": "images/vue-logo.png"
}
